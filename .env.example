# Credentials for the real API. Required only for `npm run smoke` and
# `npm run demo -- --live`; the test suite and the offline demo never read it.
#
# Get a key from the TypeSafe console: https://console.typesafe.ai
TYPESAFE_API_KEY=

# Optional overrides, read by the SDK when present.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_LOG_LEVEL=warn